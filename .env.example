# Copy this file to .env.local and fill it in. .env.local is not committed.

# The free CARTO basemaps key that the map's tiles need (get one, no account, at https://carto.com/basemaps/apikey).
# It is meant for the browser, so restrict it to this site's hosts and localhost in CARTO's dashboard.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=
